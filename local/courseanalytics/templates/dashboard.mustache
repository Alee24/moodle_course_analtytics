<div class="local_courseanalytics_dashboard container-fluid">

    {{! ===== HEADER ===== }}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="ca-title-lg mb-1">Course Learning Analytics</h1>
            <div class="ca-subtitle">AI-Powered Moodle Learning Intelligence</div>
        </div>
        <div class="d-flex ca-gap-3">
            <a href="{{urls.update}}" class="ca-btn ca-btn-outline">
                <i class="fa fa-sync-alt mr-2"></i> Update
            </a>
            <a href="{{urls.export}}" class="ca-btn ca-btn-primary">
                <i class="fa fa-download mr-2"></i> Export PDF
            </a>
            <button class="ca-btn ca-btn-primary" style="background: var(--ca-success);">
                <i class="fa fa-share-alt mr-2"></i> Share
            </button>
        </div>
    </div>

    {{! ===== GLOBAL FILTERS ===== }}
    <div class="ca-glass-panel ca-filter-bar">
        <form action="{{urls.index}}" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="ca-form-label">Category</label>
                <select name="category" class="ca-input">
                    <option value="" {{#require_category}}selected{{/require_category}}>All Categories</option>
                    {{#categories}}
                        <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                    {{/categories}}
                </select>
            </div>
            <div class="col-md-2">
                <label class="ca-form-label">Course Code</label>
                <input type="text" name="coursecode" value="{{filters.coursecode}}" placeholder="Search..." class="ca-input">
            </div>
            <div class="col-md-3">
                <label class="ca-form-label">Lecturer Email</label>
                <input type="email" name="lectureremail" value="{{filters.lectureremail}}" placeholder="Search..." class="ca-input">
            </div>
            <div class="col-md-2">
                <label class="ca-form-label">Date Range</label>
                <select class="ca-input">
                    <option>Last 7 Days</option>
                    <option>Last Month</option>
                    <option>Current Semester</option>
                </select>
            </div>
            <div class="col-md-2 d-flex ca-gap-2">
                <button type="submit" class="ca-btn ca-btn-primary flex-fill">Apply</button>
                <a href="{{urls.index}}" class="ca-btn ca-btn-outline"><i class="fa fa-times"></i></a>
            </div>
        </form>
    </div>

    {{^require_category}}
    {{! ===== EXECUTIVE KPIs ===== }}
    <div class="ca-kpi-grid">
        <div class="ca-card ca-kpi-card">
            <div class="ca-kpi-header">
                <div class="ca-kpi-icon blue"><i class="fa fa-book"></i></div>
                <div class="ca-badge blue">Live</div>
            </div>
            <div class="ca-kpi-label">Total Courses</div>
            <div class="ca-kpi-value mt-1">{{total_courses}}</div>
            <div class="ca-kpi-trend up"><i class="fa fa-arrow-up mr-1"></i> +5.2% from last month</div>
        </div>
        
        <div class="ca-card ca-kpi-card">
            <div class="ca-kpi-header">
                <div class="ca-kpi-icon green"><i class="fa fa-users"></i></div>
                <div class="ca-badge green">7 Days</div>
            </div>
            <div class="ca-kpi-label">Active Students</div>
            <div class="ca-kpi-value mt-1">{{charts.participation.active}}</div>
            <div class="ca-kpi-trend up"><i class="fa fa-arrow-up mr-1"></i> +12% from last month</div>
        </div>
        
        <div class="ca-card ca-kpi-card">
            <div class="ca-kpi-header">
                <div class="ca-kpi-icon orange"><i class="fa fa-user-clock"></i></div>
                <div class="ca-badge yellow">Action Needed</div>
            </div>
            <div class="ca-kpi-label">Inactive Students</div>
            <div class="ca-kpi-value mt-1">{{charts.participation.inactive}}</div>
            <div class="ca-kpi-trend down"><i class="fa fa-arrow-down mr-1"></i> -3.1% from last month</div>
        </div>

        <div class="ca-card ca-kpi-card">
            <div class="ca-kpi-header">
                <div class="ca-kpi-icon red"><i class="fa fa-exclamation-triangle"></i></div>
                <div class="ca-badge red">High Risk</div>
            </div>
            <div class="ca-kpi-label">At Risk Students</div>
            <div class="ca-kpi-value mt-1">24</div>
            <div class="ca-kpi-trend down"><i class="fa fa-arrow-up mr-1"></i> +2 since yesterday</div>
        </div>
    </div>

    <div class="row mb-5">
        {{! ===== AI INSIGHTS PANEL ===== }}
        <div class="col-lg-4 mb-4">
            <div class="ca-card ca-ai-panel h-100">
                <div class="p-4 border-bottom">
                    <h5 class="font-weight-bold mb-0 text-dark"><i class="fa fa-magic mr-2 text-primary"></i> AI Insights</h5>
                </div>
                <div class="ca-ai-item">
                    <div class="ca-ai-icon"><i class="fa fa-lightbulb"></i></div>
                    <div>
                        <h6 class="font-weight-bold mb-1" style="font-size:0.9rem;">Intervention Suggested</h6>
                        <p class="text-muted small mb-2">24 students have not logged in for over 14 days and are at high risk of dropping out.</p>
                        <button class="ca-btn ca-btn-outline" style="font-size:0.75rem; padding: 0.25rem 0.5rem;">Email Students</button>
                    </div>
                </div>
                <div class="ca-ai-item">
                    <div class="ca-ai-icon text-warning"><i class="fa fa-exclamation-circle"></i></div>
                    <div>
                        <h6 class="font-weight-bold mb-1" style="font-size:0.9rem;">Low Engagement Detected</h6>
                        <p class="text-muted small mb-0">Participation in 'Business Marketing' dropped by 40% this week.</p>
                    </div>
                </div>
                <div class="ca-ai-item">
                    <div class="ca-ai-icon text-success"><i class="fa fa-check-circle"></i></div>
                    <div>
                        <h6 class="font-weight-bold mb-1" style="font-size:0.9rem;">High Satisfaction</h6>
                        <p class="text-muted small mb-0">The recent H5P quiz generated an 85% completion rate.</p>
                    </div>
                </div>
            </div>
        </div>

        {{! ===== CHARTS ===== }}
        <div class="col-lg-8 mb-4">
            <div class="ca-card h-100 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="font-weight-bold text-dark m-0">Engagement & Completion Trends</h5>
                    <div class="ca-badge gray">Current Semester</div>
                </div>
                <div style="height: 300px;">
                    <canvas id="engagementChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    {{! ===== MAIN DATA TABLE ===== }}
    <div class="ca-card mb-5">
        <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="font-weight-bold text-dark m-0">Course Activity Directory</h5>
            <div class="ca-badge blue">{{total_courses}} Courses Listed</div>
        </div>
        
        <div class="ca-table-wrapper">
            <table class="ca-data-table">
                <thead>
                    <tr>
                        <th>Course Module</th>
                        <th>Lecturer</th>
                        <th>Enrollment</th>
                        <th style="width: 200px;">Completion</th>
                        <th>Risk Level</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#courses}}
                    <tr>
                        <td>
                            <div class="font-weight-bold mb-1">{{fullname}}</div>
                            <div class="text-muted small"><i class="fa fa-folder-open mr-1"></i> {{categoryname}}</div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="https://ui-avatars.com/api/?name=Lecturer&background=e2e8f0&color=475569" class="rounded-circle mr-2" width="30">
                                <span class="font-weight-500">Unassigned</span>
                            </div>
                        </td>
                        <td>
                            <span class="font-weight-bold">{{total_students}}</span> <span class="text-muted small">students</span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center ca-gap-2">
                                <div class="ca-progress-bg">
                                    <div class="ca-progress-fill green" style="width: {{completion_rate}}%;"></div>
                                </div>
                                <span class="font-weight-bold text-muted small">{{completion_rate}}%</span>
                            </div>
                        </td>
                        <td>
                            <span class="ca-badge green">Low Risk</span>
                        </td>
                        <td>
                            <a href="{{url}}" class="ca-btn ca-btn-outline">
                                View <i class="fa fa-arrow-right ml-2"></i>
                            </a>
                        </td>
                    </tr>
                    {{/courses}}
                    {{^has_courses}}
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fa fa-search fa-3x mb-3 opacity-25"></i><br>
                            <span class="font-weight-bold">No results found for your filters.</span>
                        </td>
                    </tr>
                    {{/has_courses}}
                </tbody>
            </table>
        </div>
    </div>
    {{/require_category}}
    
    {{#require_category}}
    <div class="ca-card p-5 text-center my-5">
        <div class="mb-4">
            <i class="fa fa-chart-area" style="font-size: 5rem; color: #cbd5e1;"></i>
        </div>
        <h2 class="ca-title-lg mb-3">Welcome to Course Analytics Premium</h2>
        <p class="text-muted mx-auto mb-4" style="max-width: 600px; font-size: 1.1rem;">
            Select a course category or use the search filters above to explore detailed participation metrics, AI insights, and performance indicators across your courses.
        </p>
    </div>
    {{/require_category}}

</div>

{{#js}}
require(['core/chartjs'], function(Chart) {

    Chart.defaults.font.family = "'Inter', sans-serif";
    Chart.defaults.color = '#64748b';

    // Engagement Chart
    var ctx2 = document.getElementById('engagementChart');
    if (ctx2) {
        new Chart(ctx2.getContext('2d'), {
            type: 'bar',
            data: {
                labels: [{{#charts.engagement.labels}}'{{.}}',{{/charts.engagement.labels}}],
                datasets: [{
                    label: 'Completion Progress (%)',
                    data: [{{#charts.engagement.data}}{{.}},{{/charts.engagement.data}}],
                    backgroundColor: '#3b82f6',
                    hoverBackgroundColor: '#2563eb',
                    borderRadius: 6,
                    barThickness: 20
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { 
                        beginAtZero: true, 
                        max: 100,
                        grid: { borderDash: [4, 4], color: '#e2e8f0' }
                    },
                    x: {
                        grid: { display: false }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    }
});
{{/js}}
