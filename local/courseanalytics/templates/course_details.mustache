<div class="local_courseanalytics_details container-fluid">

    {{! ===== HEADER ===== }}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="ca-title-lg mb-1">{{course.shortname}} Analytics</h1>
            <div class="ca-subtitle">{{course.fullname}}</div>
        </div>
        <div class="d-flex ca-gap-3">
            <a href="{{urls.back}}" class="ca-btn ca-btn-outline">
                <i class="fa fa-arrow-left mr-2"></i> Back
            </a>
            <a href="{{urls.export}}&format=csv" class="ca-btn ca-btn-primary">
                <i class="fa fa-file-csv mr-2"></i> Export CSV
            </a>
            <button onclick="window.print()" class="ca-btn ca-btn-primary" style="background: var(--ca-danger);">
                <i class="fa fa-file-pdf mr-2"></i> Export PDF
            </button>
        </div>
    </div>

    {{! ===== KPI CARDS ===== }}
    <div class="ca-kpi-grid">
        <div class="ca-card ca-kpi-card">
            <div class="ca-kpi-header">
                <div class="ca-kpi-icon blue"><i class="fa fa-users"></i></div>
                <div class="ca-badge blue">Enrolled</div>
            </div>
            <div class="ca-kpi-label">Total Students</div>
            <div class="ca-kpi-value mt-1">{{metrics.total_students}}</div>
        </div>
        <div class="ca-card ca-kpi-card">
            <div class="ca-kpi-header">
                <div class="ca-kpi-icon green"><i class="fa fa-bolt"></i></div>
                <div class="ca-badge green">7 Days</div>
            </div>
            <div class="ca-kpi-label">Active Students</div>
            <div class="ca-kpi-value mt-1">{{metrics.active_students}}</div>
        </div>
        <div class="ca-card ca-kpi-card">
            <div class="ca-kpi-header">
                <div class="ca-kpi-icon orange"><i class="fa fa-trophy"></i></div>
                <div class="ca-badge yellow">Overall</div>
            </div>
            <div class="ca-kpi-label">Completion Rate</div>
            <div class="ca-kpi-value mt-1">{{metrics.completion_rate}}%</div>
        </div>
        <div class="ca-card ca-kpi-card">
            <div class="ca-kpi-header">
                <div class="ca-kpi-icon blue"><i class="fa fa-cubes"></i></div>
                <div class="ca-badge gray">Content</div>
            </div>
            <div class="ca-kpi-label">Total Activities</div>
            <div class="ca-kpi-value mt-1">{{metrics.total_modules}}</div>
        </div>
        <div class="ca-card ca-kpi-card">
            <div class="ca-kpi-header">
                <div class="ca-kpi-icon purple"><i class="fa fa-clock"></i></div>
                <div class="ca-badge gray">Avg</div>
            </div>
            <div class="ca-kpi-label">Time Spent</div>
            <div class="ca-kpi-value mt-1" style="font-size: 1.5rem;">{{metrics.avg_time_spent}}</div>
        </div>
    </div>

    <div class="row mb-5">
        {{! ===== STUDENT ENGAGEMENT DASHBOARD ===== }}
        <div class="col-lg-6 mb-4">
            <div class="ca-card h-100 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <h5 class="font-weight-bold text-dark m-0"><i class="fa fa-chart-line mr-2 text-primary"></i> Engagement Timeline</h5>
                    <div class="ca-badge blue">Weekly</div>
                </div>
                <div style="height: 300px;">
                    <canvas id="courseParticipationChart"></canvas>
                </div>
            </div>
        </div>

        {{! ===== LECTURER ANALYTICS ===== }}
        <div class="col-lg-6 mb-4">
            <div class="ca-card h-100 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <h5 class="font-weight-bold text-dark m-0"><i class="fa fa-chalkboard-teacher mr-2 text-success"></i> Lecturer Activity</h5>
                </div>
                
                <div class="d-flex flex-column ca-gap-4 mt-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="font-weight-bold">Resources Uploaded</div>
                            <div class="text-muted small">Materials shared this week</div>
                        </div>
                        <div class="ca-badge blue font-weight-bold" style="font-size: 1rem;">12</div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="font-weight-bold">Forum Participation</div>
                            <div class="text-muted small">Replies to students</div>
                        </div>
                        <div class="ca-badge green font-weight-bold" style="font-size: 1rem;">34</div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="font-weight-bold">Grading Turnaround</div>
                            <div class="text-muted small">Average time to grade</div>
                        </div>
                        <div class="ca-badge yellow font-weight-bold" style="font-size: 1rem;">2.4 Days</div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="font-weight-bold">Last Login</div>
                        </div>
                        <div class="text-muted small">Today, 08:30 AM</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{! ===== TABS FOR DETAILED TABLES ===== }}
    <ul class="nav nav-pills mb-4 border-bottom pb-2" id="courseAnalyticsTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link active ca-btn ca-btn-outline border-0 mr-2" id="content-tab" data-toggle="tab" href="#content" role="tab">
                <i class="fa fa-layer-group mr-2"></i> Module Analytics
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link ca-btn ca-btn-outline border-0" id="students-tab" data-toggle="tab" href="#students" role="tab">
                <i class="fa fa-user-graduate mr-2"></i> Student Risk & Detail
            </a>
        </li>
    </ul>

    <div class="tab-content" id="courseAnalyticsTabsContent">
        
        {{! ===== MODULE ANALYTICS TAB ===== }}
        <div class="tab-pane fade show active" id="content" role="tabpanel">
            {{#sections}}
            <div class="ca-card mb-4">
                <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 font-weight-bold"><i class="fa fa-folder mr-2 text-muted"></i> {{{name}}}</h6>
                </div>
                <div class="ca-table-wrapper">
                    <table class="ca-data-table">
                        <thead>
                            <tr>
                                <th style="width: 40%;">Resource / Activity</th>
                                <th>Type</th>
                                <th class="text-center">Views</th>
                                <th class="text-center">Completion</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#modules}}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center font-weight-500">
                                        <i class="fa {{icon}} text-primary mr-3" style="width: 20px; text-align: center;"></i>
                                        {{#url}}<a href="{{url}}" target="_blank" class="text-dark">{{/url}}
                                        {{{name}}}
                                        {{#url}}</a>{{/url}}
                                    </div>
                                </td>
                                <td><span class="ca-badge gray">{{type}}</span></td>
                                <td class="text-center font-weight-bold">{{views}}</td>
                                <td class="text-center">
                                    {{#completion}}
                                        <div class="ca-progress-bg" style="width: 80px; margin: 0 auto;">
                                            <div class="ca-progress-fill blue" style="width: 75%;"></div>
                                        </div>
                                    {{/completion}}
                                    {{^completion}}
                                        <span class="text-muted small">-</span>
                                    {{/completion}}
                                </td>
                            </tr>
                            {{/modules}}
                            {{^modules}}
                            <tr><td colspan="4" class="text-center py-4 text-muted small">No activities found in this section.</td></tr>
                            {{/modules}}
                        </tbody>
                    </table>
                </div>
            </div>
            {{/sections}}
        </div>

        {{! ===== STUDENT RISK & DETAIL TAB ===== }}
        <div class="tab-pane fade" id="students" role="tabpanel">
            <div class="ca-card">
                <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="m-0 font-weight-bold">Enrolled Students</h5>
                    <button class="ca-btn ca-btn-outline"><i class="fa fa-filter mr-2"></i>Filter At-Risk</button>
                </div>
                <div class="ca-table-wrapper">
                    <table class="ca-data-table">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Activity Footprint</th>
                                <th>Current Grade</th>
                                <th>Risk Indicator</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#students}}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="https://ui-avatars.com/api/?name={{fullname}}&background=3b82f6&color=fff" class="rounded-circle mr-3" width="35">
                                        <div>
                                            <div class="font-weight-bold">{{fullname}}</div>
                                            <div class="text-muted small">{{email}}</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex ca-gap-2">
                                        <span class="ca-badge gray" title="Logins"><i class="fa fa-sign-in-alt mr-1"></i> {{logins}}</span>
                                        <span class="ca-badge gray" title="Quizzes"><i class="fa fa-check-square mr-1"></i> {{quizzes}}</span>
                                    </div>
                                    <div class="text-muted small mt-1">Last: {{lastaccess}}</div>
                                </td>
                                <td>
                                    <span class="font-weight-bold" style="font-size: 1.1rem;">{{grade}}</span>
                                </td>
                                <td>
                                    <span class="ca-badge green"><i class="fa fa-check mr-1"></i> On Track</span>
                                </td>
                                <td>
                                    <button class="ca-btn ca-btn-outline"><i class="fa fa-envelope text-primary"></i></button>
                                </td>
                            </tr>
                            {{/students}}
                            {{^students}}
                            <tr><td colspan="5" class="text-center py-5 text-muted">No students enrolled.</td></tr>
                            {{/students}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

{{#js}}
require(['core/chartjs'], function(Chart) {
    Chart.defaults.font.family = "'Inter', -apple-system, BlinkMacSystemFont, sans-serif";
    Chart.defaults.color = '#64748b';

    var ctxPart = document.getElementById('courseParticipationChart');
    if (ctxPart) {
        new Chart(ctxPart.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: ['Active Students', 'Inactive Students'],
                datasets: [{
                    data: [{{metrics.active_students}}, {{metrics.inactive_students}}],
                    backgroundColor: ['#3b82f6', '#e2e8f0'],
                    borderWidth: 0,
                    borderRadius: 8,
                    spacing: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '75%',
                plugins: { 
                    legend: { position: 'right' } 
                }
            }
        });
    }
});
{{/js}}
